<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>StbGrasshopper</AssemblyName>
    <RootNamespace>StbGrasshopper</RootNamespace>
    <LangVersion>latest</LangVersion>
    <TargetExt>.gha</TargetExt>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- GH_Component.Icon requires System.Drawing.Bitmap. Rhino/Grasshopper
         provides the supported host environment on each target platform. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <RhinoInstallDir Condition="'$(RhinoInstallDir)' == ''">$(ProgramW6432)\Rhino 8</RhinoInstallDir>
    <RhinoCommonPath Condition="'$(RhinoCommonPath)' == ''">$(RhinoInstallDir)\System\RhinoCommon.dll</RhinoCommonPath>
    <GrasshopperPath Condition="'$(GrasshopperPath)' == ''">$(RhinoInstallDir)\Plug-ins\Grasshopper\Grasshopper.dll</GrasshopperPath>
    <GhIoPath Condition="'$(GhIoPath)' == ''">$(RhinoInstallDir)\Plug-ins\Grasshopper\GH_IO.dll</GhIoPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <RhinoInstallDir Condition="'$(RhinoInstallDir)' == ''">/Applications/Rhino 8.app</RhinoInstallDir>
    <RhinoCommonPath Condition="'$(RhinoCommonPath)' == ''">$(RhinoInstallDir)/Contents/Resources/RhinoCommon.dll</RhinoCommonPath>
    <GrasshopperPath Condition="'$(GrasshopperPath)' == ''">$(RhinoInstallDir)/Contents/Resources/ManagedPlugIns/GrasshopperPlugin.rhp/Grasshopper.dll</GrasshopperPath>
    <GhIoPath Condition="'$(GhIoPath)' == ''">$(RhinoInstallDir)/Contents/Resources/ManagedPlugIns/GrasshopperPlugin.rhp/GH_IO.dll</GhIoPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" PrivateAssets="all" />
    <!-- Reference only: Rhino supplies its platform-specific Windows Forms
         implementation at runtime on both Windows and macOS. -->
    <PackageReference Include="Microsoft.WindowsDesktop.App.Ref"
                      Version="7.0.20"
                      GeneratePathProperty="true"
                      ExcludeAssets="all"
                      PrivateAssets="all" />
    <EmbeddedResource Include="Resources\Icons\*.png" />
    <Reference Include="System.Windows.Forms">
      <HintPath>$(PkgMicrosoft_WindowsDesktop_App_Ref)\ref\net7.0\System.Windows.Forms.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Grasshopper">
      <HintPath>$(GrasshopperPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RhinoCommon">
      <HintPath>$(RhinoCommonPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GH_IO">
      <HintPath>$(GhIoPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <GrasshopperLibrariesPath Condition="'$(GrasshopperLibrariesPath)' == ''">$(APPDATA)\Grasshopper\Libraries</GrasshopperLibrariesPath>
  </PropertyGroup>

  <Target Name="CopyGhaToGrasshopperLibraries"
          AfterTargets="Build"
          Condition="'$(OS)' == 'Windows_NT'">
    <MakeDir Directories="$(GrasshopperLibrariesPath)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(GrasshopperLibrariesPath)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
