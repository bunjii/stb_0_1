# --- PRACTICE SAMPLE INPUT ---
# Wood single-story practice model with timber floor diaphragm (FLOOR_MAG=2.0).
# 3.64 m x 3.64 m plan, floor level z=3.0 m, semi-rigid diaphragm at 2x floor multiplier.

# --- MATERIAL(MATE) ---
# MATE,   ID,       NAME,        E,        G,    Gamma,    Alpha,       Fy
#     ,     ,           ,    N/mm2,    N/mm2,    kN/m3,        -,    N/mm2

MATE,      1,       Sugi,     9500,      633,      5.0,    3e-06,       20

# --- SECTION(SECT) ---
# SECT,   ID,       NAME,    MAT,   TYPE,     DIM1,     DIM2,     DIM3,     DIM4
#     ,     ,           ,       ,       ,       mm,       mm,       mm,       mm
#   TYPE: 0=RECT  1=CIRC  2=I  3=CHS  4=RHS
#   DIM3,DIM4: optional; omit for types with fewer dimensions

SECT,      1,       C120,      1,      0,    120.0,    120.0
SECT,      2,       B240,      1,      0,    120.0,    240.0
SECT,      3,       BR90,      1,      0,     45.0,     90.0

# --- NODE ---
# NODE,   ID,         X,         Y,         Z
#     ,     ,         m,         m,         m

NODE,      1,       0.0,       0.0,       3.0
NODE,      2,      3.64,       0.0,       3.0
NODE,      3,      3.64,      3.64,       3.0
NODE,      4,       0.0,      3.64,       3.0
NODE,      5,       0.0,       0.0,       0.0
NODE,      6,      3.64,       0.0,       0.0
NODE,      7,      3.64,      3.64,       0.0
NODE,      8,       0.0,      3.64,       0.0

# --- ELEMENT(ELEM) ---
# ELEM,   ID,     Ni,     Nj,    SEC,     Beta
#     ,     ,       ,       ,       ,      deg

ELEM,      1,      1,      2,      2,      0.0
ELEM,      2,      2,      3,      2,      0.0
ELEM,      3,      3,      4,      2,      0.0
ELEM,      4,      4,      1,      2,      0.0
ELEM,      5,      5,      1,      1,      0.0
ELEM,      6,      6,      2,      1,      0.0
ELEM,      7,      7,      3,      1,      0.0
ELEM,      8,      8,      4,      1,      0.0
ELEM,      9,      5,      3,      3,      0.0
ELEM,     10,      6,      4,      3,      0.0

# --- DIAPHRAGM REGION(DIAP) ---
# DIAP,   ID,       NAME, TYPE,  SRC,    MAGID,        T,    THETA,           RA,     HMAX
#     ,     ,           ,     ,     ,         ,       mm,      deg,          rad,       mm
#   TYPE: 0=RIGID  1=SEMI  2=FLEX
#   SRC:  0=DMAT  1=TIMBER_FLOOR  2=TIMBER_ROOF
#   MAGID: SRC=0 -> DMAT ID; SRC=1/2 -> floor/roof multiplier
#   RA,HMAX: optional (blank allowed)

# Timber floor diaphragm: FLOOR_MAG=2.0 (床倍率2倍).
# DREG is omitted here; outer polygon 1-2-3-4 is auto-derived from DMEM below.

DIAP,     10,    2F_MAIN,    1,    1,      2.0,     1000,      0.0,  0.006666667,     1820

# --- DIAPHRAGM OUTER POLYGON(DREG) ---
# DREG, DIAP,     N1,     N2,     N3
#   Optional when DMEM is supplied; derived automatically if omitted.

# --- DIAPHRAGM MEMBRANE ELEMENT(DMEM) ---
# DMEM,   ID,   DIAP,     N1,     N2,     N3

DMEM,   1001,     10,      1,      2,      3
DMEM,   1002,     10,      1,      3,      4

# --- DIAPHRAGM CONNECTION(DCON) ---
# DCON, DIAP, TRGT,     ID, CONN,      TOL,  SPACING
#     ,     ,     ,       ,     ,        m,        m
#   TRGT: 0=AUTO  1=ELEM  2=NODE
#   ID: target element/node ID (blank when TRGT=0)
#   CONN: 0=RIGID in-plane  1=OPEN/disconnected
#   SPACING: optional metadata (blank allowed)

# Tie floor perimeter beams to the timber diaphragm for in-plane transfer.

DCON,     10,    1,      1,    0,     0.01
DCON,     10,    1,      2,    0,     0.01
DCON,     10,    1,      3,    0,     0.01
DCON,     10,    1,      4,    0,     0.01

# --- CONSTRAINT(CONS) ---
# CONS, NODE,   TX,   TY,   TZ,   RX,   RY,   RZ
#   TX..RZ: 0=FREE  1=FIXED

#    NODE ID,   TX,   TY,   TZ,   RX,   RY,   RZ

CONS,      5,    1,    1,    1,    1,    1,    1
CONS,      6,    1,    1,    1,    1,    1,    1
CONS,      7,    1,    1,    1,    1,    1,    1
CONS,      8,    1,    1,    1,    1,    1,    1

# --- LOAD NAME(LNME) ---
# LNME,   LC, TYPE,     LABEL
#   TYPE: 1=DL  2=LL  3=LL(E)  4=S  5=W  6=E  7=CUSTOM(label required)

LNME,      1,    1
LNME,      2,    6,  EQX
LNME,      3,    6,  EQY

# --- POINT LOAD(PLOD) ---
# PLOD, NODE,   LC,       PX,       PY,       PZ,       MX,       MY,       MZ
#     ,     ,     ,       kN,       kN,       kN,      kNm,      kNm,      kNm

#    NODE ID,   LC,     PX,     PY,     PZ,     MX,     MY,     MZ
# LC 1: gravity at floor corners

PLOD,      1,    1,      0.0,      0.0,     -1.5,      0.0,      0.0,      0.0
PLOD,      2,    1,      0.0,      0.0,     -1.5,      0.0,      0.0,      0.0
PLOD,      3,    1,      0.0,      0.0,     -1.5,      0.0,      0.0,      0.0
PLOD,      4,    1,      0.0,      0.0,     -1.5,      0.0,      0.0,      0.0

# --- DIAPHRAGM LOAD(DLOD) ---
# DLOD, DIAP,   LC, TYPE,         PX,         PY
#     ,     ,     ,     ,      kN/m2,      kN/m2
#   TYPE: 0=AREA(PX,PY)  1=LINE(N1,N2,PX,PY)  2=MBTR(ELEM,PX,PY)
#         3=MASS(MASS,AX,AY)  4=WGHT(WGHT,AX,AY)
#   MBTR: member-transfer metadata
#   AX,AY: seismic acceleration coefficients for MASS/WGHT

#         3=MASS(MASS,AX,AY kg/m2)  4=WGHT(WGHT,AX,AY kN/m2)
# Seismic in-plane area loads on the 2x timber floor (total 2.0 kN per direction).
# Floor area = 3.64 x 3.64 = 13.25 m2 -> 2.0 / 13.25 = 0.151 kN/m2

DLOD,     10,    2,    0,      0.151,        0.0
DLOD,     10,    3,    0,        0.0,      0.151

# --- ELEMENT LOAD(ELOD) ---
# ELOD, ELEM,   LC,   EG,      WXi,      WYi,      WZi,      WXj,      WYj,      WZj
#     ,     ,     ,     ,     kN/m,     kN/m,     kN/m,     kN/m,     kN/m,     kN/m
#   EG: 0=element local axes  1=global axes

#    ELEM ID,   LC,  E/G,    WXi,    WYi,    WZi,    WXj,    WYj,    WZj
# Gravity line loads on floor perimeter beams in global Z.

ELOD,      1,    1,    1,      0.0,      0.0,     -0.4,      0.0,      0.0,     -0.4
ELOD,      2,    1,    1,      0.0,      0.0,     -0.4,      0.0,      0.0,     -0.4
ELOD,      3,    1,    1,      0.0,      0.0,     -0.4,      0.0,      0.0,     -0.4
ELOD,      4,    1,    1,      0.0,      0.0,     -0.4,      0.0,      0.0,     -0.4
