#                           (N/mm2)   (N/mm2)   (N/mm2)       (-)  (kN/m3)       (-)
DMAT,     10,  FC24_SLAB,   25500,   25500, 10625.0, 0.20, 0.0, 0.0

# --- DIAPHRAGM REGION(DIAP) ---
