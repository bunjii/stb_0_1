# --- DIAPHRAGM CONNECTION(DCON) ---
# DCON, DIAP, TRGT,     ID, CONN,      TOL,  SPACING
#     ,     ,     ,       ,     ,        m,        m
#   TRGT: 0=AUTO  1=ELEM  2=NODE
#   ID: target element/node ID (blank when TRGT=0)
#   CONN: 0=RIGID in-plane  1=OPEN/disconnected
#   SPACING: optional metadata (blank allowed)

# DCON AUTO removed: ties every member to the diaphragm and is not needed when
# floor nodes are shared with DMEM. Use explicit DCON per beam if required.

# --- WOOD RATED WALL(WWLL) ---
# WWLL,   ID,       NAME, MODEL,        M,        L,        H,  DIR,             RA,     N1,     N2,     N3,     N4,   DIAP, LAYO
#     ,     ,           ,     ,        -,        m,        m,     ,            rad,       ,       ,       ,       ,       ,     
#   MODEL: 0=equivalent brace  1=shear panel  2=membrane(reserved)
#   DIR: 0=X  1=Y
#   N1..N4: corner nodes (bottom line N1-N2, top line N3-N4)
#   DIAP: diaphragm ID for in-plane MPC tie (blank=none)
#   LAYO: 0=single brace  1=X-brace pair (default)

# 1F west edge (x=0) between y=6.885-7.795, wall multiplier M=2.0

WWLL,      1,    W1_WEST,    0,      2.0,     0.91,    2.735,    0,   0.0083333333,      0,      1,      3,      2,       ,    1
